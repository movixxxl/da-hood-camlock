        end

    end)

end

--==================================================
-- LOCK / UNLOCK
--==================================================

Button.MouseButton1Click:Connect(function()

    if lockEnabled then

        lockEnabled = false
        lockedPlayer = nil
        Button.Text = "Lock Target"

        return
    end

    local target = getPlayerInCenterArea()

    if target then

        lockedPlayer = target
        lockEnabled = true

        Button.Text = "Locked: " .. target.Name

        showOwnerTextOnce()

    else

        Button.Text = "No Player in Center Area"

    end

end)

--==================================================
-- CAMERA FOLLOW + PREDICTION
--==================================================

RunService.RenderStepped:Connect(function()

    if not lockEnabled then
        return
    end

    if not lockedPlayer then
        return
    end

    if not lockedPlayer.Character then
        return
    end

    local root =
        lockedPlayer.Character:FindFirstChild("HumanoidRootPart")

    local humanoid =
        lockedPlayer.Character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        return
    end

    local velocity = root.AssemblyLinearVelocity

    -- Y eksenini normal prediction'dan çıkarıyoruz
    local horizontalVelocity = Vector3.new(
        velocity.X,
        0,
        velocity.Z
    )

    local isJumping =
        humanoid:GetState() == Enum.HumanoidStateType.Jumping
        or humanoid:GetState() == Enum.HumanoidStateType.Freefall

    local predictedPosition = root.Position

    -- SADECE HAREKET EDERKEN MOVE PREDICTION
    if horizontalVelocity.Magnitude > 0.5 then

        predictedPosition =
            root.Position +
            horizontalVelocity * predictionTime

    end

    -- ZIPLARKEN AYRI JUMP PREDICTION
    if isJumping then

        predictedPosition =
            predictedPosition +
            Vector3.new(
                0,
                velocity.Y * jumpPredictionTime,
                0
            )

    end

    -- FOLLOW CAMERA
    Camera.CFrame = CFrame.lookAt(
        Camera.CFrame.Position,
        predictedPosition
    )

end)
